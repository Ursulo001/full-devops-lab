# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Box légère Debian 11 (Bullseye)
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_check_update = true

  # Nom de la VM
  config.vm.hostname = "docker-registry-server"

  # Ressources allouées à la VM
  config.vm.provider "virtualbox" do |vb|
    vb.name = "docker-registry-server"
    vb.memory = "512"  # 1GB RAM suffisant pour Docker Registry léger
    vb.cpus = 1
  end

  # Réseau : redirection du port 5000 pour accéder au registry depuis l'hôte
  config.vm.network "forwarded_port", guest: 5000, host: 5000, auto_correct: true
  config.vm.network "private_network", ip: "192.168.56.12"
end
