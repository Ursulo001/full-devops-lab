# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_check_update = true
  
  config.vm.hostname = "stage-vm"

  
  config.vm.provider "virtualbox" do |vb|
    vb.name = "prod-server"
    vb.memory = "2048"  
    vb.cpus = 2
  end

  config.vm.network "private_network", ip: "192.168.56.1"
end
