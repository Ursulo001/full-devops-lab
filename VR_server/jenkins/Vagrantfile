# git@<IP_hote>:<groupe>/<projet>.git-*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Box Debian 11 (Bullseye) légère et stable
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_check_update = true

  # Nom de la VM
  config.vm.hostname = "jenkins-server"

  # Ressources allouées à la VM
  config.vm.provider "virtualbox" do |vb|
    vb.name = "jenkins-server"
    vb.memory = "3072"
    vb.cpus = 2
  end

  # Réseau : redirection du port Jenkins vers l'hôte
  config.vm.network "forwarded_port", guest: 8080, host: 8080, auto_correct: true
  config.vm.network "private_network", ip: "192.168.56.11"
end
